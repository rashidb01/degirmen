# Copy this file to .env and fill in real values. .env is gitignored.

PORT=4100

# AI chat assistant (Groq) - used for /api/chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Simple password that protects /admin.html and the admin API routes
ADMIN_KEY=change-me

# Comma-separated origins allowed to call the API (leave empty to allow all in dev)
CORS_ORIGIN=

# R-Keeper POS integration (see backend/integrations/rkeeper.js) — off by
# default. Fill these in once your R-Keeper reseller has enabled StationAPI/
# RK7 XML-Server and given you an endpoint + credentials.
RKEEPER_ENABLED=false
RKEEPER_API_URL=
RKEEPER_LOGIN=
RKEEPER_PASSWORD=
